# DEFY TPO — Closing Doc Order

# Resend API key for the defywholesale.com sending domain (required).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sending identity. Must be on a domain verified in this Resend account.
RESEND_FROM_EMAIL=Closingdocorder@defywholesale.com

# Where orders are delivered. Comma-separated for multiple recipients.
# setup@ routes to the Cloudflare `submission-conditions` worker.
RESEND_TO_EMAILS=setup@defywholesale.com
